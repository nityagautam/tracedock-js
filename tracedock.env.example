# @tracedock/playwright environment example
#
# Playwright does not load env files automatically. Load this file in the shell before the test:
#   set -a
#   . ./.env.tracedock.local
#   set +a
#   npx playwright test
#
# Keep the real token in your local secret store or CI secret manager. Never commit it.

# Required publishing configuration
TRACEDOCK_URL=http://localhost:3000
TRACEDOCK_TOKEN=td_replace_me
TRACEDOCK_PROJECT=checkout-web

# Optional organization slug; enables the browser URL printed after publication
TRACEDOCK_ORG=acme

# Run identity. The default pattern produces checkout-e2e-20260924T104231456Z.
TRACEDOCK_RUN_NAME='checkout-e2e'
TRACEDOCK_RUN_NAME_PATTERN='{name}-{timestamp}'

# Portable run bundle. A ZIP is written for every execution by default. When unset, the output
# directory is tracedock-bundles beside the configured JUnit file.
# Allowed modes: always, on-failure, off
# TRACEDOCK_BUNDLE_MODE='always'
# TRACEDOCK_BUNDLE_OUTPUT_DIR='test-results/tracedock-bundles'

# Exact @p0 through @p3 Playwright tags synchronize testcase priority by default.
# Set false to leave all priorities under manual TraceDock control.
# TRACEDOCK_PRIORITY_FROM_TAGS=true

# Optional execution context
# TRACEDOCK_ENVIRONMENT='staging'
# TRACEDOCK_BRANCH='main'
# TRACEDOCK_COMMIT_SHA='0123456789abcdef'
# TRACEDOCK_PULL_REQUEST=123
# TRACEDOCK_SHARD_GROUP='build-84'

# CI context
#
# GitHub Actions, GitLab CI, Azure Pipelines, Jenkins, CircleCI, Buildkite,
# Bitbucket Pipelines and TeamCity are detected automatically. Uncomment these
# values only to override detected metadata or configure a custom CI system.
#
# Allowed providers: github, gitlab, jenkins, circleci, buildkite, azure,
# bitbucket, teamcity, local, unknown
# TRACEDOCK_CI_PROVIDER='unknown'
# TRACEDOCK_CI_BUILD_ID='pipeline-9001'
# TRACEDOCK_CI_BUILD_NUMBER=84
# TRACEDOCK_CI_PIPELINE_NAME='Nightly regression'
# TRACEDOCK_CI_BUILD_NAME='Nightly regression'
# TRACEDOCK_CI_PIPELINE_URL='https://ci.example/pipelines/9001'
# TRACEDOCK_CI_JOB_NAME='playwright-chromium'
# TRACEDOCK_CI_JOB_URL='https://ci.example/jobs/12001'
# TRACEDOCK_CI_ACTOR='release-bot'
# TRACEDOCK_CI_TRIGGER_EVENT='schedule'
# TRACEDOCK_CI_TRIGGERED_BY='release-bot'

# TRACEDOCK_CI_BUILD_NAME is an alias for TRACEDOCK_CI_PIPELINE_NAME.
# TRACEDOCK_CI_TRIGGERED_BY is an alias for TRACEDOCK_CI_ACTOR.
