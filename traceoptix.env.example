# @traceoptix/playwright environment example
#
# Playwright does not load env files automatically. Load this file in the shell before the test:
#   set -a
#   . ./.env.traceoptix.local
#   set +a
#   npx playwright test
#
# Keep the real token in your local secret store or CI secret manager. Never commit it.
# TRACEOPTIX_UPLOAD_* settings belong to the TraceOptix SERVER, not this reporter.
# Live publishing uses signed per-file uploads, not the buffered single-shot endpoint.
# Fixed evidence caps (MiB): screenshot/diff/log 10; HAR/report/other 50;
# trace 100; video 500. Oversized evidence is skipped with a warning during capture.
# Server limits and portable ZIP restrictions: docs/upload-limits.md in the server repo.

# Required publishing configuration
TRACEOPTIX_URL=http://localhost:3000
TRACEOPTIX_TOKEN=td_replace_me
TRACEOPTIX_PROJECT=checkout-web

# Optional organization slug; enables the browser URL printed after publication
TRACEOPTIX_ORG=acme

# Run identity. The default pattern produces checkout-e2e-20260924T104231456Z.
TRACEOPTIX_RUN_NAME='checkout-e2e'
TRACEOPTIX_RUN_NAME_PATTERN='{name}-{timestamp}'

# Run tags controlled by CI. Use key=value pairs, or a JSON object when values contain commas or
# colons. Reporter-option tags override matching environment entries. The reporter always supplies
# the reserved playwright-version and test-count run tags itself.
# TRACEOPTIX_RUN_TAGS='suite=regression,team=checkout'
# TRACEOPTIX_RUN_TAGS='{"suite":"smoke,critical","target":"https://checkout.example.com"}'

# Portable run bundle. A ZIP is written for every execution by default. When unset, the output
# directory is traceoptix-bundles beside the configured JUnit file.
# Allowed modes: always, on-failure, off
# TRACEOPTIX_BUNDLE_MODE='always'
# TRACEOPTIX_BUNDLE_OUTPUT_DIR='test-results/traceoptix-bundles'

# Exact @p0 through @p3 Playwright tags synchronize testcase priority by default.
# Set false to leave all priorities under manual TraceOptix control.
# TRACEOPTIX_PRIORITY_FROM_TAGS=true

# Optional execution context
# TRACEOPTIX_ENVIRONMENT='staging'
# TRACEOPTIX_BRANCH='main'
# TRACEOPTIX_COMMIT_SHA='0123456789abcdef'
# TRACEOPTIX_PULL_REQUEST=123
# TRACEOPTIX_SHARD_GROUP='build-84'

# CI context
#
# GitHub Actions, GitLab CI, Azure Pipelines, Jenkins, CircleCI, Buildkite,
# Bitbucket Pipelines and TeamCity are detected automatically. Uncomment these
# values only to override detected metadata or configure a custom CI system.
#
# Allowed providers: github, gitlab, jenkins, circleci, buildkite, azure,
# bitbucket, teamcity, local, unknown
# TRACEOPTIX_CI_PROVIDER='unknown'
# TRACEOPTIX_CI_BUILD_ID='pipeline-9001'
# TRACEOPTIX_CI_BUILD_NUMBER=84
# TRACEOPTIX_CI_PIPELINE_NAME='Nightly regression'
# TRACEOPTIX_CI_BUILD_NAME='Nightly regression'
# TRACEOPTIX_CI_PIPELINE_URL='https://ci.example/pipelines/9001'
# TRACEOPTIX_CI_JOB_NAME='playwright-chromium'
# TRACEOPTIX_CI_JOB_URL='https://ci.example/jobs/12001'
# TRACEOPTIX_CI_ACTOR='release-bot'
# TRACEOPTIX_CI_TRIGGER_EVENT='schedule'
# TRACEOPTIX_CI_TRIGGERED_BY='release-bot'

# TRACEOPTIX_CI_BUILD_NAME is an alias for TRACEOPTIX_CI_PIPELINE_NAME.
# TRACEOPTIX_CI_TRIGGERED_BY is an alias for TRACEOPTIX_CI_ACTOR.
