{
  "name": "@traceoptix/playwright",
  "version": "1.0.2",
  "description": "Playwright reporter for publishing Playwright test results and test evidence to TraceOptix",
  "homepage": "https://github.com/nityagautam/traceoptix-playwright#readme",
  "bugs": {
    "url": "https://github.com/nityagautam/traceoptix-playwright/issues"
  },
  "keywords": [
    "playwright",
    "reporter",
    "junit",
    "test-results",
    "traceoptix"
  ],
  "type": "module",
  "workspaces": ["examples/plain", "examples/bdd"],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.cts",
      "import": "./dist/test.cjs",
      "require": "./dist/test.cjs",
      "default": "./dist/test.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LOCAL_DEVELOPMENT.md",
    "traceoptix.env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.typecheck.json",
    "test": "npm run build && vitest run src",
    "examples:typecheck": "npm run build && tsc -p tsconfig.examples.json",
    "examples:check": "npm run examples:typecheck && bddgen --config examples/bdd/playwright.config.ts && playwright test --config examples/plain/playwright.config.ts --list && playwright test --config examples/bdd/playwright.config.ts --list",
    "example:plain": "npm run build && playwright test --config examples/plain/playwright.config.ts",
    "example:bdd": "npm run build && bddgen --config examples/bdd/playwright.config.ts && playwright test --config examples/bdd/playwright.config.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run examples:check"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.2",
    "playwright-bdd": "9.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nityagautam/traceoptix-playwright.git"
  }
}
