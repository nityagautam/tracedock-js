{
  "name": "@traceoptix/playwright",
  "version": "1.0.0",
  "description": "Playwright reporter for publishing Playwright test results and test evidence to TraceOptix",
  "homepage": "https://github.com/nityagautam/traceoptix-playwright#readme",
  "bugs": {
    "url": "https://github.com/nityagautam/traceoptix-playwright/issues"
  },
  "keywords": [
    "playwright",
    "reporter",
    "junit",
    "test-results",
    "traceoptix"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LOCAL_DEVELOPMENT.md",
    "traceoptix.env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nityagautam/traceoptix-playwright.git"
  }
}
