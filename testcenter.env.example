# @testcenter/playwright environment example
#
# Playwright does not load env files automatically. Load this file in the shell before the test:
#   set -a
#   . ./.env.testcenter.local
#   set +a
#   npx playwright test
#
# Keep the real token in your local secret store or CI secret manager. Never commit it.

# Required publishing configuration
TESTCENTER_URL=http://localhost:3000
TESTCENTER_TOKEN=tc_replace_me
TESTCENTER_PROJECT=checkout-web

# Optional organization slug; enables the browser URL printed after publication
TESTCENTER_ORG=acme

# Run identity. The default pattern produces checkout-e2e-20260924T104231456Z.
TESTCENTER_RUN_NAME='checkout-e2e'
TESTCENTER_RUN_NAME_PATTERN='{name}-{timestamp}'

# Portable run bundle. A ZIP is written for every execution by default. When unset, the output
# directory is testcenter-bundles beside the configured JUnit file.
# Allowed modes: always, on-failure, off
# TESTCENTER_BUNDLE_MODE='always'
# TESTCENTER_BUNDLE_OUTPUT_DIR='test-results/testcenter-bundles'

# Exact @p0 through @p3 Playwright tags synchronize testcase priority by default.
# Set false to leave all priorities under manual Test Center control.
# TESTCENTER_PRIORITY_FROM_TAGS=true

# Optional execution context
# TESTCENTER_ENVIRONMENT='staging'
# TESTCENTER_BRANCH='main'
# TESTCENTER_COMMIT_SHA='0123456789abcdef'
# TESTCENTER_PULL_REQUEST=123
# TESTCENTER_SHARD_GROUP='build-84'

# CI context
#
# GitHub Actions, GitLab CI, Azure Pipelines, Jenkins, CircleCI, Buildkite,
# Bitbucket Pipelines and TeamCity are detected automatically. Uncomment these
# values only to override detected metadata or configure a custom CI system.
#
# Allowed providers: github, gitlab, jenkins, circleci, buildkite, azure,
# bitbucket, teamcity, local, unknown
# TESTCENTER_CI_PROVIDER='unknown'
# TESTCENTER_CI_BUILD_ID='pipeline-9001'
# TESTCENTER_CI_BUILD_NUMBER=84
# TESTCENTER_CI_PIPELINE_NAME='Nightly regression'
# TESTCENTER_CI_BUILD_NAME='Nightly regression'
# TESTCENTER_CI_PIPELINE_URL='https://ci.example/pipelines/9001'
# TESTCENTER_CI_JOB_NAME='playwright-chromium'
# TESTCENTER_CI_JOB_URL='https://ci.example/jobs/12001'
# TESTCENTER_CI_ACTOR='release-bot'
# TESTCENTER_CI_TRIGGER_EVENT='schedule'
# TESTCENTER_CI_TRIGGERED_BY='release-bot'

# TESTCENTER_CI_BUILD_NAME is an alias for TESTCENTER_CI_PIPELINE_NAME.
# TESTCENTER_CI_TRIGGERED_BY is an alias for TESTCENTER_CI_ACTOR.
